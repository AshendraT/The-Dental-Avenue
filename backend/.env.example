# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://www.thedentalavenue.lk

# Database Configuration
MONGO_URI=mongodb://localhost:27107/dental_avenue

# Authentication Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_12345
JWT_EXPIRE=24h

# Email Service Configuration (Nodemailer)
# Fallback to local console log email if SMTP variables are blank
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM=thedentalavenue.lk@gmail.com

# Clinic Administration
ADMIN_EMAIL=thedentalavenue.lk@gmail.com

# Initial Seed Data (for running npm run seed)
INITIAL_ADMIN_EMAIL=thedentalavenue.lk@gmail.com
INITIAL_ADMIN_PASSWORD=AdminPass123!

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here

